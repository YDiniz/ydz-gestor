<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.MenuPrincipalController" styleClass="root">

    <VBox alignment="CENTER" spacing="25" maxWidth="620" styleClass="card">

        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <Label text="YDZ Gestor" styleClass="label-titulo"/>

        <GridPane alignment="CENTER" hgap="15" vgap="15">

            <Button fx:id="botaoNovoServico" styleClass="cartao-menu" onAction="#abrirNovoServico"
                    GridPane.columnIndex="0" GridPane.rowIndex="0">
                <graphic>
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="📝" styleClass="cartao-icone"/>
                        <Label text="Novo Serviço" styleClass="cartao-texto"/>
                    </VBox>
                </graphic>
            </Button>

            <Button styleClass="cartao-menu" onAction="#abrirListaServicos"
                    GridPane.columnIndex="1" GridPane.rowIndex="0">
                <graphic>
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="📋" styleClass="cartao-icone"/>
                        <Label text="Acompanhar Serviços" styleClass="cartao-texto" wrapText="true"
                               textAlignment="CENTER"/>
                    </VBox>
                </graphic>
            </Button>

            <Button styleClass="cartao-menu" onAction="#abrirPagamentos"
                    GridPane.columnIndex="2" GridPane.rowIndex="0">
                <graphic>
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="💰" styleClass="cartao-icone"/>
                        <Label text="Pagamentos" styleClass="cartao-texto"/>
                    </VBox>
                </graphic>
            </Button>

            <Button styleClass="cartao-menu" onAction="#abrirEscolas"
                    GridPane.columnIndex="0" GridPane.rowIndex="1">
                <graphic>
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="🏫" styleClass="cartao-icone"/>
                        <Label text="Escolas" styleClass="cartao-texto"/>
                    </VBox>
                </graphic>
            </Button>

            <Button styleClass="cartao-menu" onAction="#abrirFuncionarios"
                    GridPane.columnIndex="1" GridPane.rowIndex="1">
                <graphic>
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="👷" styleClass="cartao-icone"/>
                        <Label text="Funcionários" styleClass="cartao-texto"/>
                    </VBox>
                </graphic>
            </Button>

            <Button styleClass="cartao-menu" onAction="#sair"
                    GridPane.columnIndex="2" GridPane.rowIndex="1">
                <graphic>
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="🚪" styleClass="cartao-icone"/>
                        <Label text="Sair" styleClass="cartao-texto"/>
                    </VBox>
                </graphic>
            </Button>

        </GridPane>

    </VBox>

</StackPane>