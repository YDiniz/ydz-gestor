<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.MenuPrincipalController" styleClass="root">

    <VBox alignment="CENTER" spacing="20" maxWidth="320" styleClass="card">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="YDZ Gestor" styleClass="label-titulo"/>

        <Button fx:id="botaoNovoServico" text="Novo Serviço" prefWidth="200" onAction="#abrirNovoServico"/>
        <Button text="Acompanhar Serviços" prefWidth="200" onAction="#abrirListaServicos"/>
        <Button text="Funcionários" prefWidth="200" onAction="#abrirFuncionarios"/>
        <Button text="Escolas" prefWidth="200" onAction="#abrirEscolas"/>

    </VBox>

</StackPane>