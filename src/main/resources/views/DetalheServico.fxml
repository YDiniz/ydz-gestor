<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.DetalheServicoController" styleClass="root">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Detalhes do Serviço" styleClass="label-titulo"/>

    <Label fx:id="labelNome"/>
    <Label fx:id="labelTipo"/>
    <Label fx:id="labelStatus"/>
    <Label fx:id="labelEscola"/>

    <Separator/>

    <Label text="Funcionários:" style="-fx-font-weight: bold;"/>
    <ListView fx:id="listaFuncionarios" prefHeight="80" prefWidth="350"/>

    <Label text="Documentos (duplo clique para abrir):" style="-fx-font-weight: bold;"/>
    <ListView fx:id="listaDocumentos" prefHeight="80" prefWidth="350"/>

    <Label text="Pagamentos:" style="-fx-font-weight: bold;"/>
    <ListView fx:id="listaPagamentos" prefHeight="80" prefWidth="350"/>

    <Label fx:id="labelTotalPago" style="-fx-font-weight: bold; -fx-text-fill: #0C447C;"/>

    <Button text="Fechar" onAction="#fechar"/>

</VBox>