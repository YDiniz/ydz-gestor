<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.EditarServicoController" styleClass="root">

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">

        <VBox alignment="TOP_CENTER" spacing="12" maxWidth="580" styleClass="card">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <Label text="Editar Serviço" styleClass="label-titulo"/>

            <Label fx:id="labelNome" style="-fx-font-weight: bold;"/>
            <Label fx:id="labelTipo"/>
            <Label fx:id="labelEscola"/>

            <Separator/>

            <Label text="Status:" style="-fx-font-weight: bold;"/>
            <HBox alignment="CENTER" spacing="10">
                <ComboBox fx:id="comboStatus" prefWidth="250"/>
                <Button text="Salvar status" onAction="#salvarStatus"/>
            </HBox>

            <Separator/>

            <Label text="Funcionários:" style="-fx-font-weight: bold;"/>
            <ListView fx:id="listaFuncionarios" prefHeight="120" prefWidth="500" maxWidth="500"/>
            <Button text="Remover selecionado" onAction="#removerFuncionario"/>
            <HBox alignment="CENTER" spacing="10">
                <ComboBox fx:id="comboNovoFuncionario" prefWidth="250" promptText="Adicionar funcionário"/>
                <Button text="Adicionar" onAction="#adicionarFuncionario"/>
            </HBox>

            <Separator/>

            <Label text="Documentos:" style="-fx-font-weight: bold;"/>
            <ListView fx:id="listaDocumentos" prefHeight="120" prefWidth="500" maxWidth="500"/>
            <Button text="Remover selecionado" onAction="#removerDocumento"/>
            <HBox alignment="CENTER" spacing="10">
                <ComboBox fx:id="comboTipoDocumento" prefWidth="250" promptText="Tipo do documento"/>
                <Button text="Anexar arquivo..." onAction="#anexarDocumento"/>
            </HBox>

            <Separator/>

            <Label text="Pagamentos:" style="-fx-font-weight: bold;"/>
            <ListView fx:id="listaPagamentos" prefHeight="120" prefWidth="500" maxWidth="500"/>
            <HBox alignment="CENTER" spacing="10">
                <Button text="Editar selecionado" onAction="#editarPagamento"/>
                <Button text="Excluir selecionado" onAction="#excluirPagamento"/>
            </HBox>

            <Separator/>

            <Label fx:id="labelMensagem"/>
            <Button text="Fechar" onAction="#fechar"/>

        </VBox>

    </ScrollPane>

</StackPane>