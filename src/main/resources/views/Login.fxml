<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LoginController">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Mini-ERP Reformas" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextField fx:id="campoLogin" promptText="Usuário" prefWidth="220"/>
    <PasswordField fx:id="campoSenha" promptText="Senha" prefWidth="220"/>

    <Button text="Entrar" prefWidth="220" onAction="#entrar"/>

    <Label fx:id="labelErro" style="-fx-text-fill: red;"/>

</VBox>