<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.AcompanharServicosController" styleClass="root">

    <VBox alignment="TOP_CENTER" spacing="12" maxWidth="400" styleClass="card">

        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <Label text="Acompanhar Serviços" styleClass="label-titulo"/>

        <Button text="← Voltar ao Menu" onAction="#voltarAoMenu"/>

        <Label text="Filtrar por status:"/>
        <ComboBox fx:id="comboFiltroStatus" prefWidth="250"/>

        <ListView fx:id="listaServicos" prefHeight="300" prefWidth="400"/>

        <Button text="Editar serviço selecionado" onAction="#editarSelecionado"/>

    </VBox>

</StackPane>