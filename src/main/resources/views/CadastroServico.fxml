<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.CadastroServicoController">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Novo Serviço" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Nome do serviço:"/>
    <TextField fx:id="campoNome" prefWidth="300"/>

    <Label text="Tipo da obra:"/>
    <TextField fx:id="campoTipoObra" prefWidth="300"/>

    <Label text="Escola:"/>
    <ComboBox fx:id="comboEscola" prefWidth="300"/>

    <Label text="Funcionários:"/>
    <VBox fx:id="containerFuncionarios" prefWidth="300"/>

    <Button text="Salvar" prefWidth="150" onAction="#salvar"/>

    <Label fx:id="labelMensagem"/>

</VBox>