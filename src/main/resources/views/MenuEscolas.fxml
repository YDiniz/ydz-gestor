<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.MenuEscolasController" styleClass="root">

    <VBox alignment="CENTER" spacing="20" maxWidth="320" styleClass="card">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <Label text="Escolas" styleClass="label-titulo"/>

        <Button fx:id="botaoCadastrar" text="Cadastrar Escola" prefWidth="200" onAction="#abrirCadastro"/>
        <Button text="Escolas Cadastradas" prefWidth="200" onAction="#abrirLista"/>
        <Button text="← Voltar ao Menu" onAction="#voltarAoMenu"/>

    </VBox>

</StackPane>